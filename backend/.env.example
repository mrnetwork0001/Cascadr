# ---------------------------------------------------------------------------
# Cascadr backend configuration. Copy to .env and fill in.
# The service runs with none of these set: it falls back to the in-memory
# graph and refuses to place live orders.
# ---------------------------------------------------------------------------

# Neo4j. Unset -> in-memory seed graph is used instead.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Bitget. Public market data needs no credentials; trading does.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

# Bitget DEMO trading key, created in Bitget's Demo Trading mode (no real
# funds). When set, paper trades are placed on Bitget's demo exchange, which
# fills and records them, instead of being simulated here. GET /venue shows
# Bitget's own view of the demo account.
BITGET_DEMO_API_KEY=
BITGET_DEMO_API_SECRET=
BITGET_DEMO_PASSPHRASE=

# SAFETY GATE. Orders are simulated unless this is exactly "false".
# Never set to false until the strategy has run in paper for a meaningful period.
CASCADR_PAPER_TRADING=true

# Hard cap on a single order's notional, in USDT. Applies in live mode.
CASCADR_MAX_ORDER_USDT=250

# SEC requires a descriptive UA with contact info on every EDGAR request.
SEC_USER_AGENT=Cascadr Research contact@example.com

# ---------------------------------------------------------------------------
# LLM gateway. 0G Private Computer's router (https://router-api.0g.ai/v1)
# serves claude-* models on the Anthropic /messages shape and the rest on
# OpenAI /chat/completions; "auto" picks by model name.
# Unset -> the News Oracle falls back to deterministic keyword matching and
# labels itself "heuristic" in the decision trace.
# ---------------------------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER=0g-compute
LLM_API_FORMAT=auto

# ---------------------------------------------------------------------------
# Autonomous agent. Off unless exactly "true".
# ---------------------------------------------------------------------------
CASCADR_AUTONOMOUS=false
CASCADR_POLL_SECONDS=600
# Headlines the LLM scores below this shock are declined and never propagate.
CASCADR_SHOCK_FLOOR=0.40
# Hard ceiling on LLM calls per hour, whatever the news volume.
CASCADR_MAX_LLM_PER_HOUR=60
CASCADR_NEWS_MAX_AGE_HOURS=6

# Starting equity of the paper account, in USDT.
CASCADR_PAPER_EQUITY=100000

# SQLite file for decisions, positions and the equity journal.
CASCADR_DB=cascadr.db

# Browser origins allowed to read the API cross-origin (reads only).
CASCADR_CORS_ORIGINS=http://localhost:4010,http://127.0.0.1:4010

# Required for every endpoint that writes or spends: manual oracle/contagion
# calls, placing or closing positions, running a cycle, EDGAR refresh. Send it
# as the X-Admin-Token header. Unset -> those endpoints answer 503.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CASCADR_ADMIN_TOKEN=
